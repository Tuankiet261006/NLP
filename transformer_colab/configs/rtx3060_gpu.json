{
  "seed": 42,
  "data": {
    "train_src": "shared/data/processed/train.en",
    "train_tgt": "shared/data/processed/train.vi",
    "dev_src": "shared/data/processed/tst2012.en",
    "dev_tgt": "shared/data/processed/tst2012.vi",
    "test_src": "shared/data/processed/tst2013.en",
    "test_tgt": "shared/data/processed/tst2013.vi",
    "lowercase": false,
    "max_length": 160,
    "min_frequency": 2
  },
  "model": {
    "d_model": 512,
    "nhead": 8,
    "num_encoder_layers": 6,
    "num_decoder_layers": 6,
    "dim_feedforward": 2048,
    "dropout": 0.1,
    "max_position_embeddings": 256
  },
  "training": {
    "epochs": 10,
    "batch_tokens": 3000,
    "learning_rate_scale": 1.0,
    "warmup_steps": 4000,
    "adam_betas": [0.9, 0.98],
    "adam_epsilon": 1e-9,
    "label_smoothing": 0.1,
    "gradient_clip_norm": 1.0,
    "mixed_precision": true,
    "checkpoint_metric": "dev_loss",
    "early_stopping_patience": 4,
    "dev_bleu_max_sentences": 64,
    "dev_bleu_beam_width": 3,
    "num_workers": 0
  },
  "decoding": {
    "beam_width": 3,
    "max_length": 160,
    "length_penalty": 0.6
  },
  "artifacts": {
    "checkpoint_dir": "transformer_colab/checkpoints/rtx3060",
    "log_dir": "transformer_colab/logs/rtx3060",
    "output_dir": "transformer_colab/outputs/rtx3060"
  }
}

